{
  "name": "stats",
  "version": "0.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "lint:check": "eslint '**/*.{js,ts}'",
    "lint:fix": "eslint '**/*.{js,ts}' --fix"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@dcl/eslint-config": "^2.0.0",
    "@dcl/schemas": "^10.3.0",
    "@dcl/test-helpers": "^0.2.0",
    "@types/google-protobuf": "^3.15.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.6.1",
    "typescript": "^4.7.4"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/core-commons": "^0.10.1",
    "@dcl/fetch-component": "^1.1.1",
    "@dcl/http-server": "^2.1.0",
    "@dcl/metrics": "^1.0.1",
    "@dcl/protocol": "1.0.0-30361475985.commit-df8a4ff",
    "@well-known-components/env-config-provider": "^1.1.1",
    "@well-known-components/interfaces": "^1.5.2",
    "@well-known-components/logger": "^3.1.3",
    "@well-known-components/nats-component": "^2.0.0",
    "dcl-catalyst-client": "^22.0.0",
    "google-protobuf": "^3.20.1"
  }
}
