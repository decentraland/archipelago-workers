# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=5001
HTTP_SERVER_HOST=0.0.0.0

NATS_URL=

# comms-gatekeeper base URL. Unset disables the handshake ban check and the ban
# sweep — it fails OPEN, so a missing value silently allows every handshake.
COMMS_GATEKEEPER_URL=


# Platform deny list JSON. Defaults to the public Decentraland list when unset.
DENYLIST_JSON_URL=

# A second island_changed naming the same island as the last one forwarded to a socket, within
# this many milliseconds, is dropped: the client already holds a token for that room, and a
# second string for it would make it join the room it is joining. 0 disables.
ISLAND_CHANGED_DEDUP_MS=10000

# Seconds of silence after which uWebSockets closes an idle /ws socket. The server pings idle
# clients (sendPingsAutomatically), so a connected-but-silent client is kept alive and never needs
# to send heartbeats of its own. uWS only accepts 0 (never time out) or values >= 8, and rounds to
# the nearest multiple of 4. 90 is the historical value; leave it alone unless you know why.
WS_IDLE_TIMEOUT_SECONDS=90
