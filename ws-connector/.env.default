# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=5001
HTTP_SERVER_HOST=0.0.0.0

NATS_URL=

# Base URL of the comms-gatekeeper service. When set, WS Connector checks
# GET /users/:address/bans at handshake time and re-checks connected peers on a
# sweep, kicking anyone banned. Unset (or empty) disables both checks and every
# handshake is allowed — the check fails OPEN so a gatekeeper outage cannot lock
# the platform out, which also means a missing value silently disables ban
# enforcement. Documented here because archipelago-core, which read the same
# variable, was removed. See docs/core-decommission-runbook.md.
COMMS_GATEKEEPER_URL=

