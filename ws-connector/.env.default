# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=5001
HTTP_SERVER_HOST=0.0.0.0

NATS_URL=

# comms-gatekeeper base URL. Unset disables the handshake ban check and the ban
# sweep — it fails OPEN, so a missing value silently allows every handshake.
COMMS_GATEKEEPER_URL=


# Platform deny list JSON. Defaults to the public Decentraland list when unset.
DENYLIST_JSON_URL=


# Seconds after which uWebSockets closes an idle /ws socket. The server pings idle clients
# (sendPingsAutomatically) and the pong resets this timer, so a client that is merely silent — as
# iteration 2's heartbeat-free clients are — is kept alive and never needs to send anything of its
# own. What this bounds is how long a socket whose peer is *gone* (laptop asleep, NAT flow expired,
# carrier drop) may linger unanswered before being reaped.
#
# uWS accepts only 0 or values >= 8, and rounds to the nearest multiple of 4; ws-connector refuses
# to start on anything in between rather than let uWS abort route registration. 0 means "never time
# out" and is for local debugging only: it removes the *only* thing that closes a dead socket, so
# half-open connections accumulate, each keeping its peersRegistry entry alive as a ghost peer, and
# memory grows until restart. Never set 0 in production.
#
# 90 is the historical value; leave it alone unless you know why.
WS_IDLE_TIMEOUT_SECONDS=90

# Whether the client heartbeat is still republished on NATS as `peer.<addr>.heartbeat`, and the
# session close as `peer.<addr>.disconnect`. Iteration 2 retired both: archipelago-stats was their
# only consumer, it has been deleted from this repo, and Pulse reads positions from its own
# transport instead. Neither subject has a subscriber any more.
#
# `true` stays the default so that a deploy which sets nothing keeps the pre-rollout behaviour, but
# production wants `false` — it was flipped at rollout step 8. With it off the heartbeat packet is
# still decoded and accepted (old clients keep sending it) and everything else on the socket
# (island_changed forwarding, the peers registry, the server's idle pings) is untouched.
#
# What keeps reconnects working once heartbeats are gone is a separate, ungated publish:
# ws-connector announces every successful handshake on `peer.<addr>.connect` and comms-gatekeeper
# re-emits that peer's current `engine.peer.<addr>.island_changed` from it. There is no key for that
# announcement, on purpose — gating it with this one would make the flip cost an island assignment on
# every reconnect, because gatekeeper otherwise publishes an assignment only when Pulse reports a
# cluster change. It is the client heartbeat's real replacement; this key only retires the
# republishing. See docs/stats-decommission-runbook.md §7 for what to check on the broker — and
# note that the check there is the `nats sub 'peer.*.connect'` observation, not
# `ws_connector_peer_connect_publish_failures_total`: that counter only catches a publish the NATS
# client refused outright, and one made while it is reconnecting is buffered and can be lost with
# the counter still flat at zero.
#
# Why the switch is still here with nothing left to feed: it is the writer half of the stats
# rollback (docs/stats-decommission-runbook.md, Rollback step 4). A redeployed stats with the intake
# still off answers 200 with an empty peer map, which every consumer reads as "everyone left". The
# code comes out in a follow-up, once that rollback is out of the question.
#
# What the flip cost, and why its ordering was strict: stats had no time-based peer expiry — it
# dropped a peer only on `peer.<addr>.disconnect`. With the intake off its peer map froze rather
# than emptied: no arrivals, no departures, and every session that ended inside the off-window
# stayed "online" in /peers, /parcels and /hot-scenes (which feeds places). So step 8 waited on the
# CloudFlare cut (step 5) having moved every stats path to Pulse and comms-gatekeeper, AND on
# heartbeat-free clients reaching >= 95 % of sessions (step 7). It was never a free canary:
# flipping back resumes publishing but cannot clear stale entries, because the sessions that left
# will never announce it.
#
# The value is read leniently and never fails a deploy: `false`, `0`, `no`, `off` turn forwarding
# off; `true`, `1`, `yes`, `on`, blank and unset leave it on; anything else leaves it on and logs a
# warning naming the key and the value, so a typo cannot take the /ws gateway down. That leniency
# cuts both ways: HEARTBEAT_FORWARDING_ENABLED=fasle leaves forwarding ON, so an operator verifying
# the flip greps the logs for `does not recognise`.
HEARTBEAT_FORWARDING_ENABLED=true
