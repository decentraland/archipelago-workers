# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.

HTTP_SERVER_PORT=5001
HTTP_SERVER_HOST=0.0.0.0

NATS_URL=

# comms-gatekeeper base URL. Unset disables the handshake ban check and the ban
# sweep — it fails OPEN, so a missing value silently allows every handshake.
COMMS_GATEKEEPER_URL=


# Platform deny list JSON. Defaults to the public Decentraland list when unset.
DENYLIST_JSON_URL=


# Seconds after which uWebSockets closes an idle /ws socket. The server pings idle clients
# (sendPingsAutomatically) and the pong resets this timer, so a client that is merely silent — as
# iteration 2's heartbeat-free clients are — is kept alive and never needs to send anything of its
# own. What this bounds is how long a socket whose peer is *gone* (laptop asleep, NAT flow expired,
# carrier drop) may linger unanswered before being reaped.
#
# uWS accepts only 0 or values >= 8, and rounds to the nearest multiple of 4; ws-connector refuses
# to start on anything in between rather than let uWS abort route registration. 0 means "never time
# out" and is for local debugging only: it removes the *only* thing that closes a dead socket, so
# half-open connections accumulate, each keeping its peersRegistry entry alive as a ghost peer, and
# memory grows until restart. Never set 0 in production.
#
# 90 is the historical value; leave it alone unless you know why.
WS_IDLE_TIMEOUT_SECONDS=90
